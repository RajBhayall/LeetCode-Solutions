class Solution {
public:
    char findTheDifference(string s, string t) {
        int n=s.size(), m=t.size();
        if(n==0){
            return t[0];
        }
        sort(s.begin(), s.end());
        sort(t.begin(), t.end());

        int i=0;
        while(i<n){
            for(int j=0; j<m; j++){
                if(s[i] != t[j]){
                    return t[j];
                }
                i++;
            }
        }
        return 0;
    }
};
