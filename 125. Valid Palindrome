class Solution {
public:
    bool isPalindrome(string s) {
        string newS = "";
        for(int i=0; i<s.size(); i++){
            if(isalnum(s[i])){
                if(s[i]>='A' && s[i]<='Z'){
                    s[i]+=32;
                    newS+=s[i];
                }else{
                        newS+=s[i];
                }
            }
        }
        string rev = newS;
        reverse(rev.begin(), rev.end());
        
        return rev == newS;
        }
};
