class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int tsum = 0;
        for(int num : nums){
            tsum += num;
        }
        int lsum=0;
        for(int i=0; i<nums.size(); i++){
            tsum -=nums[i];
            if(tsum == lsum){
                return i;
            }
            lsum += nums[i];
        }
        return -1;
    }
};
